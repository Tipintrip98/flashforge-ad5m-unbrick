<!--
    Tipaldi AI - desktop futuristico. Coordinate di progetto 1920x1080 (scalate da un Viewbox).
    Gli elementi con x:Name sono riempiti da Desktop.cs. Animazioni limitate a 30 FPS.
-->
<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1920" Height="1080" ClipToBounds="True">
    <Canvas.Resources>
        <SolidColorBrush x:Key="Cyan" Color="#38D6FF"/>
        <SolidColorBrush x:Key="Gold" Color="#E8B04B"/>
        <SolidColorBrush x:Key="Dim" Color="#6E8494"/>
        <SolidColorBrush x:Key="PanelBg" Color="#B80A121A"/>
        <SolidColorBrush x:Key="PanelLine" Color="#3338D6FF"/>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayBold}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#E8B04B"/>
        </Style>

        <Style x:Key="HudButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DCE9F2"/>
            <Setter Property="FontFamily" Value="{DynamicResource DisplayBold}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="12" BorderThickness="1" BorderBrush="#5538D6FF" Background="#1A38D6FF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#3338D6FF"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#E8B04B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#5538D6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HudButtonSmall" TargetType="Button" BasedOn="{StaticResource HudButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="92"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" CornerRadius="10" Padding="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1A38D6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- trama esagonale di sfondo -->
        <DrawingBrush x:Key="HexGrid" TileMode="Tile" Viewport="0,0,52,90" ViewportUnits="Absolute" Opacity="0.07">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M 26,0 L 52,15 L 52,45 L 26,60 L 0,45 L 0,15 Z M 26,60 L 26,90">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#38D6FF" Thickness="1"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Canvas.Resources>

    <Canvas.Triggers>
        <EventTrigger RoutedEvent="Canvas.Loaded">
            <BeginStoryboard>
                <Storyboard Timeline.DesiredFrameRate="30">
                    <DoubleAnimation Storyboard.TargetName="RotA" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:1:20" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="RotB" Storyboard.TargetProperty="Angle" From="360" To="0" Duration="0:0:50" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="RotC" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:28" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="RotD" Storyboard.TargetProperty="Angle" From="360" To="0" Duration="0:0:18" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:5" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleX" From="0.94" To="1.06" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleY" From="0.94" To="1.06" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0.55" To="0.95" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="ScanMove" Storyboard.TargetProperty="Y" From="-40" To="1100" Duration="0:0:7" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="LiveDot" Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Canvas.Triggers>

    <!-- sfondo -->
    <Rectangle Width="1920" Height="1080" Fill="{StaticResource HexGrid}"/>
    <Ellipse Canvas.Left="460" Canvas.Top="-50" Width="1000" Height="1000" IsHitTestVisible="False">
        <Ellipse.Fill>
            <RadialGradientBrush>
                <GradientStop Color="#2238D6FF" Offset="0"/>
                <GradientStop Color="#0038D6FF" Offset="1"/>
            </RadialGradientBrush>
        </Ellipse.Fill>
    </Ellipse>
    <Rectangle Width="1920" Height="2" IsHitTestVisible="False" Opacity="0.55">
        <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#0038D6FF" Offset="0"/>
                <GradientStop Color="#AA38D6FF" Offset="0.5"/>
                <GradientStop Color="#0038D6FF" Offset="1"/>
            </LinearGradientBrush>
        </Rectangle.Fill>
        <Rectangle.RenderTransform>
            <TranslateTransform x:Name="ScanMove" Y="-40"/>
        </Rectangle.RenderTransform>
    </Rectangle>

    <!-- barra superiore -->
    <Grid x:Name="TopBar" Canvas.Left="60" Canvas.Top="34" Width="1800" Height="50">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="M 14,0 L 28,8 L 28,24 L 14,32 L 0,24 L 0,8 Z" Stroke="#38D6FF" StrokeThickness="2" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <TextBlock Text="T I P A L D I    A I" FontFamily="{DynamicResource Display}" FontSize="34" Foreground="#EAF6FF" VerticalAlignment="Center"/>
            <TextBlock Text="  //  SISTEMA OPERATIVO PERSONALE" FontFamily="{DynamicResource Display}" FontSize="18" Foreground="#6E8494" VerticalAlignment="Center" Margin="10,6,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border CornerRadius="15" BorderBrush="#4438D6FF" BorderThickness="1" Padding="14,5" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="LiveDot" Width="9" Height="9" Fill="#38D6FF" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock Text="SISTEMI ONLINE" FontFamily="{DynamicResource DisplayBold}" FontSize="15" Foreground="#DCE9F2"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="15" BorderBrush="#4438D6FF" BorderThickness="1" Padding="14,5" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ClaudeDot" Width="9" Height="9" Fill="#E8B04B" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ClaudeText" Text="CLAUDE" FontFamily="{DynamicResource DisplayBold}" FontSize="15" Foreground="#DCE9F2"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="15" BorderBrush="#55E8B04B" BorderThickness="1" Padding="14,5">
                <TextBlock x:Name="OverdriveText" Text="OVERDRIVE" FontFamily="{DynamicResource DisplayBold}" FontSize="15" Foreground="#E8B04B"/>
            </Border>
        </StackPanel>
    </Grid>

    <!-- pannello sinistro: ora, saluto, contesto, avvio rapido -->
    <Border x:Name="PanelLeft" Canvas.Left="60" Canvas.Top="112" Width="470" Height="520" CornerRadius="18" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelLine}" BorderThickness="1" Padding="28,20">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ClockText" Text="00:00" FontFamily="{DynamicResource Display}" FontSize="108" Foreground="#FFFFFF" Margin="0,-14,0,-10"/>
                <TextBlock x:Name="SecondsText" Text="00" FontFamily="{DynamicResource Mono}" FontSize="26" Foreground="#38D6FF" VerticalAlignment="Bottom" Margin="10,0,0,20"/>
            </StackPanel>
            <TextBlock x:Name="DateText" FontFamily="{DynamicResource DisplayBold}" FontSize="18" Foreground="#38D6FF"/>
            <TextBlock x:Name="GreetText" FontFamily="{DynamicResource Display}" FontSize="20" Foreground="#9FB3C2" Margin="0,4,0,0"/>
            <Rectangle Height="1" Fill="#3338D6FF" Margin="0,16,0,14"/>
            <TextBlock Text="CONTESTO ATTUALE" Style="{StaticResource Caption}"/>
            <TextBlock x:Name="CtxName" Text="IN ATTESA" FontFamily="{DynamicResource DisplayBold}" FontSize="36" Foreground="#38D6FF" Margin="0,2,0,0"/>
            <TextBlock x:Name="CtxTime" FontFamily="{DynamicResource Mono}" FontSize="14" Foreground="#6E8494" Margin="0,0,0,8"/>
            <StackPanel x:Name="CtxBars"/>
            <TextBlock Text="AVVIO RAPIDO" Style="{StaticResource Caption}" Margin="0,14,0,4"/>
            <WrapPanel x:Name="QuickPanel"/>
        </StackPanel>
    </Border>

    <!-- spazio di lavoro: il desktop ordinato per contesto -->
    <Border x:Name="PanelWork" Canvas.Left="60" Canvas.Top="660" Width="470" Height="372" CornerRadius="18" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelLine}" BorderThickness="1" Padding="22,18">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="6,0,6,6">
                <TextBlock Text="SPAZIO DI LAVORO" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="WorkCount" HorizontalAlignment="Right" FontFamily="{DynamicResource Mono}" FontSize="13" Foreground="#6E8494"/>
            </Grid>
            <WrapPanel x:Name="WorkPanel"/>
        </DockPanel>
    </Border>

    <!-- reattore -->
    <Canvas x:Name="Reactor" Width="1920" Height="1080">
        <Canvas.RenderTransform><ScaleTransform ScaleX="0.84" ScaleY="0.84" CenterX="960" CenterY="450"/></Canvas.RenderTransform>
        <Ellipse Canvas.Left="610" Canvas.Top="100" Width="700" Height="700" Stroke="#3338D6FF" StrokeThickness="1"/>
        <Ellipse Canvas.Left="640" Canvas.Top="130" Width="640" Height="640" Stroke="#8838D6FF" StrokeThickness="2" StrokeDashArray="1 5" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><RotateTransform x:Name="RotA"/></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Canvas.Left="660" Canvas.Top="150" Width="600" Height="600" Stroke="#E8B04B" StrokeThickness="3" StrokeDashArray="34 120" Opacity="0.85" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><RotateTransform x:Name="RotC"/></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Canvas.Left="690" Canvas.Top="180" Width="540" Height="540" Stroke="#2238D6FF" StrokeThickness="16" StrokeDashArray="0.6 0.25" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><RotateTransform x:Name="RotB"/></Ellipse.RenderTransform>
        </Ellipse>
        <!-- tracce e archi di telemetria (CPU r=236, RAM r=210) -->
        <Path Stroke="#1838D6FF" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 779.2,601.7 A 236,236 0 1 1 1140.8,601.7"/>
        <Path x:Name="CpuArc" Stroke="#38D6FF" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <Path.Effect><DropShadowEffect Color="#38D6FF" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/></Path.Effect>
        </Path>
        <Path Stroke="#18E8B04B" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 799.1,585.0 A 210,210 0 1 1 1120.9,585.0"/>
        <Path x:Name="RamArc" Stroke="#E8B04B" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <Path.Effect><DropShadowEffect Color="#E8B04B" BlurRadius="14" ShadowDepth="0" Opacity="0.8"/></Path.Effect>
        </Path>
        <!-- anello a segmenti e radar -->
        <Ellipse Canvas.Left="790" Canvas.Top="280" Width="340" Height="340" Stroke="#5538D6FF" StrokeThickness="26" StrokeDashArray="0.55 0.22" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><RotateTransform x:Name="RotD"/></Ellipse.RenderTransform>
        </Ellipse>
        <Path Data="M 960,450 L 960,276 A 174,174 0 0 1 1083,327 Z" RenderTransformOrigin="0,0" Opacity="0.55">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0038D6FF" Offset="0"/>
                    <GradientStop Color="#6638D6FF" Offset="1"/>
                </LinearGradientBrush>
            </Path.Fill>
            <Path.RenderTransform><RotateTransform x:Name="Sweep" CenterX="960" CenterY="450"/></Path.RenderTransform>
        </Path>
        <!-- nucleo -->
        <Ellipse x:Name="Glow" Canvas.Left="830" Canvas.Top="320" Width="260" Height="260" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#9938D6FF" Offset="0"/>
                    <GradientStop Color="#2238D6FF" Offset="0.55"/>
                    <GradientStop Color="#0038D6FF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Canvas.Left="885" Canvas.Top="375" Width="150" Height="150" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><ScaleTransform x:Name="CoreScale"/></Ellipse.RenderTransform>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop Color="#FFBFF3FF" Offset="0.25"/>
                    <GradientStop Color="#CC38D6FF" Offset="0.6"/>
                    <GradientStop Color="#0038D6FF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Path Data="M 960,382 L 1019,484 L 901,484 Z" Stroke="#CCFFFFFF" StrokeThickness="2" Opacity="0.75"/>
    </Canvas>

    <!-- valori della telemetria -->
    <StackPanel Canvas.Left="540" Canvas.Top="404" Width="116">
        <TextBlock Text="CPU" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
        <TextBlock x:Name="CpuValue" Text="0%" FontFamily="{DynamicResource Display}" FontSize="44" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
    </StackPanel>
    <StackPanel Canvas.Left="1264" Canvas.Top="404" Width="120">
        <TextBlock Text="MEMORIA" Style="{StaticResource Caption}"/>
        <TextBlock x:Name="RamValue" Text="0%" FontFamily="{DynamicResource Display}" FontSize="44" Foreground="#FFFFFF"/>
        <TextBlock x:Name="RamSub" FontFamily="{DynamicResource Mono}" FontSize="12" Foreground="#6E8494"/>
    </StackPanel>
    <TextBlock x:Name="NetValue" Canvas.Left="660" Canvas.Top="116" Width="600" TextAlignment="Center" FontFamily="{DynamicResource Mono}" FontSize="16" Foreground="#9FB3C2"/>
    <TextBlock x:Name="DiskValue" Canvas.Left="660" Canvas.Top="764" Width="600" TextAlignment="Center" FontFamily="{DynamicResource Mono}" FontSize="16" Foreground="#9FB3C2"/>

    <!-- console AI -->
    <Border x:Name="PanelConsole" Canvas.Left="560" Canvas.Top="812" Width="800" Height="220" CornerRadius="18" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelLine}" BorderThickness="1" Padding="24,16">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="CONSOLE AI" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
            <StackPanel x:Name="ConsoleLines"/>
        </DockPanel>
    </Border>

    <!-- pannello destro: integrità di sistema -->
    <Border x:Name="PanelRight" Canvas.Left="1390" Canvas.Top="112" Width="470" Height="620" CornerRadius="18" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelLine}" BorderThickness="1" Padding="28,20">
        <StackPanel>
            <TextBlock Text="INTEGRITÀ DI SISTEMA" Style="{StaticResource Caption}"/>
            <TextBlock x:Name="StatusWord" Text="ANALISI..." FontFamily="{DynamicResource DisplayBold}" FontSize="52" Foreground="#38D6FF" Margin="0,0,0,-4"/>
            <TextBlock x:Name="StatusTime" FontFamily="{DynamicResource Mono}" FontSize="13" Foreground="#6E8494"/>
            <Rectangle Height="1" Fill="#3338D6FF" Margin="0,14,0,12"/>
            <TextBlock Text="UNITÀ DI MEMORIA" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
            <StackPanel x:Name="DisksPanel"/>
            <Rectangle Height="1" Fill="#3338D6FF" Margin="0,14,0,12"/>
            <TextBlock Text="SEGNALAZIONI" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
            <StackPanel x:Name="IssuesPanel"/>
        </StackPanel>
    </Border>

    <!-- azioni -->
    <Border x:Name="PanelActions" Canvas.Left="1390" Canvas.Top="760" Width="470" Height="272" CornerRadius="18" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelLine}" BorderThickness="1" Padding="24,18">
        <StackPanel>
            <TextBlock Text="PROTOCOLLI" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
            <UniformGrid Columns="2">
                <Button x:Name="BtnScan" Content="SCANSIONE COMPLETA" Style="{StaticResource HudButton}" Margin="0,0,6,10"/>
                <Button x:Name="BtnReport" Content="REPORT SETTIMANALE" Style="{StaticResource HudButton}" Margin="6,0,0,10"/>
                <Button x:Name="BtnOrganize" Content="ORDINA ORA" Style="{StaticResource HudButton}" Margin="0,0,6,10"/>
                <Button x:Name="BtnUndo" Content="ANNULLA ORDINE" Style="{StaticResource HudButton}" Margin="6,0,0,10"/>
            </UniformGrid>
            <Button x:Name="BtnSkills" Content="AGGIORNA SKILL DI CLAUDE" Style="{StaticResource HudButton}"/>
        </StackPanel>
    </Border>
</Canvas>
