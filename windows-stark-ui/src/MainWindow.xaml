<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stark HUD - Windows 10 UI Pack"
        Width="1100" Height="720" MinWidth="940" MinHeight="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Palette Stark HUD -->
        <SolidColorBrush x:Key="Accent" Color="#38D6FF" />
        <SolidColorBrush x:Key="AccentDeep" Color="#0096C7" />
        <SolidColorBrush x:Key="Gold" Color="#F2B544" />
        <SolidColorBrush x:Key="Text" Color="#EAF6FF" />
        <SolidColorBrush x:Key="Muted" Color="#8FA6B8" />
        <SolidColorBrush x:Key="Faint" Color="#5A6E7C" />
        <SolidColorBrush x:Key="CardBg" Color="#0D141B" />
        <SolidColorBrush x:Key="CardHover" Color="#111C25" />
        <SolidColorBrush x:Key="Hairline" Color="#1A2D39" />
        <FontFamily x:Key="Display">Segoe UI Light</FontFamily>
        <FontFamily x:Key="Mono">Consolas</FontFamily>

        <!-- Interruttore stile iOS / HyperOS -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="13" Background="#16212A" BorderBrush="#2A3B47" BorderThickness="1" />
                            <Border x:Name="On" CornerRadius="13" Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#5FE0FF" Offset="0" />
                                        <GradientStop Color="#0096C7" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Ellipse x:Name="Thumb" Width="20" Height="20" Margin="3,0,0,0" HorizontalAlignment="Left" Fill="#B9C7D1">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="Shift" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Schede (righe) -->
        <Style x:Key="RowCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="18,14,16,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardHover}" />
                    <Setter Property="BorderBrush" Value="#2A5568" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,18,0" />
        </Style>
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="4,14,0,10" />
        </Style>

        <!-- Pulsanti -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#03141B" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Halo" CornerRadius="24" Background="#38D6FF" Opacity="0.0" Margin="-4">
                                <Border.Effect><BlurEffect Radius="14" /></Border.Effect>
                            </Border>
                            <Border x:Name="Body" CornerRadius="22" Padding="30,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#7FE8FF" Offset="0" />
                                        <GradientStop Color="#38D6FF" Offset="0.5" />
                                        <GradientStop Color="#18B4E0" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" CornerRadius="22" Padding="22,0" Background="Transparent" BorderBrush="#2A3B47" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="#38D6FF" />
                                <Setter TargetName="Body" Property="Background" Value="#0F1D26" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" CornerRadius="10" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#16242E" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selettore a segmenti (stile Apple) -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Body" CornerRadius="16" Padding="18,7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#1A2C38" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScroll" TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="#2A4452" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CityBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentDeep}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Body" CornerRadius="12" Background="#0A1016" BorderBrush="#2A3B47" BorderThickness="1" Padding="12,7">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="#38D6FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <!-- Ombra su uno strato separato: le animazioni non la ricalcolano -->
        <Border CornerRadius="28" Background="#05080B">
            <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="#000000" /></Border.Effect>
        </Border>

        <Border CornerRadius="28" BorderThickness="1">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#5538D6FF" Offset="0" />
                    <GradientStop Color="#1238D6FF" Offset="0.5" />
                    <GradientStop Color="#33F2B544" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Background>
                <RadialGradientBrush Center="0.18,0.3" GradientOrigin="0.18,0.3" RadiusX="0.9" RadiusY="1.1">
                    <GradientStop Color="#0E1C26" Offset="0" />
                    <GradientStop Color="#080D12" Offset="0.55" />
                    <GradientStop Color="#05080B" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="86" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Barra del titolo (trascinabile) -->
                <Grid x:Name="TitleBar" Grid.ColumnSpan="2" Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center">
                            <Ellipse.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#38D6FF" Opacity="0.9" /></Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="STARK HUD  //  SETUP" Margin="12,0,0,0" Foreground="{StaticResource Muted}" FontFamily="{DynamicResource Mono}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button x:Name="BtnMin" Style="{StaticResource ChromeButton}" Content="&#xE921;" ToolTip="Riduci a icona" />
                        <Button x:Name="BtnClose" Style="{StaticResource ChromeButton}" Content="&#xE8BB;" ToolTip="Chiudi" />
                    </StackPanel>
                </Grid>

                <!-- Colonna eroe: reattore animato + stato del sistema -->
                <Grid Grid.Row="1" Margin="26,6,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Canvas x:Name="Reactor" Width="250" Height="250" HorizontalAlignment="Left" Margin="10,4,0,0">
                        <Ellipse Width="250" Height="250" Stroke="#2238D6FF" StrokeThickness="1" />
                        <Ellipse x:Name="R1" Width="236" Height="236" Canvas.Left="7" Canvas.Top="7" Stroke="#38D6FF" StrokeThickness="2"
                                 StrokeDashArray="22 14" Opacity="0.55" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="R2" Width="210" Height="210" Canvas.Left="20" Canvas.Top="20" Stroke="#F2B544" StrokeThickness="2.5"
                                 StrokeDashArray="9 70" Opacity="0.9" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="R3" Width="186" Height="186" Canvas.Left="32" Canvas.Top="32" Stroke="#38D6FF" StrokeThickness="12"
                                 StrokeDashArray="1.6 0.55" Opacity="0.22" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="R4" Width="150" Height="150" Canvas.Left="50" Canvas.Top="50" Stroke="#7FE8FF" StrokeThickness="1.2"
                                 StrokeDashArray="2 3" Opacity="0.6" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="122" Height="122" Canvas.Left="64" Canvas.Top="64" Stroke="#38D6FF" StrokeThickness="1" Opacity="0.5" />
                        <Ellipse x:Name="Glow" Width="170" Height="170" Canvas.Left="40" Canvas.Top="40" Opacity="0.55">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#6638D6FF" Offset="0" />
                                    <GradientStop Color="#0038D6FF" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="Core" Width="70" Height="70" Canvas.Left="90" Canvas.Top="90">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                                    <GradientStop Color="#FFCFF6FF" Offset="0.3" />
                                    <GradientStop Color="#CC38D6FF" Offset="0.6" />
                                    <GradientStop Color="#0038D6FF" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Canvas.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <!-- 30 fps bastano per rotazioni lente: meta' lavoro per la GPU -->
                                    <Storyboard Timeline.DesiredFrameRate="30">
                                        <DoubleAnimation Storyboard.TargetName="R1" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:40" RepeatBehavior="Forever" />
                                        <DoubleAnimation Storyboard.TargetName="R2" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="-360" Duration="0:0:14" RepeatBehavior="Forever" />
                                        <DoubleAnimation Storyboard.TargetName="R3" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:90" RepeatBehavior="Forever" />
                                        <DoubleAnimation Storyboard.TargetName="R4" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="-360" Duration="0:0:26" RepeatBehavior="Forever" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0.4" To="0.85" Duration="0:0:2.8" AutoReverse="True" RepeatBehavior="Forever">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Canvas.Triggers>
                    </Canvas>

                    <StackPanel Grid.Row="1" Margin="2,18,0,0">
                        <TextBlock Text="STARK HUD" Foreground="{StaticResource Text}" FontFamily="{DynamicResource Display}" FontWeight="Light" FontSize="46" />
                        <TextBlock Text="WINDOWS 10  //  UI PACK" Foreground="{StaticResource Accent}" FontFamily="{DynamicResource Mono}" FontSize="12" Margin="2,0,0,0" />
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="2,14,8,0"
                                   Text="Interfaccia futuristica ispirata a Stark Industries, con la pulizia di Apple TV e HyperOS. Nessun file di sistema modificato: ogni cambiamento si annulla con un clic." />
                    </StackPanel>

                    <Border Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,8,14" CornerRadius="16" Background="#0A1117" BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="SYSTEM CHECK" Foreground="{StaticResource Gold}" FontFamily="{DynamicResource Mono}" FontSize="11" Margin="0,0,0,6" />
                            <TextBlock x:Name="InfoText" Foreground="{StaticResource Muted}" FontFamily="{DynamicResource Mono}" FontSize="11.5" LineHeight="19" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Colonna principale -->
                <Grid Grid.Row="1" Grid.Column="1" Margin="10,6,26,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border HorizontalAlignment="Left" CornerRadius="20" Background="#0A1117" BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabTheme" Style="{StaticResource Segment}" GroupName="tabs" Content="Tema" IsChecked="True" />
                            <RadioButton x:Name="TabComponents" Style="{StaticResource Segment}" GroupName="tabs" Content="Componenti" />
                            <RadioButton x:Name="TabTweaks" Style="{StaticResource Segment}" GroupName="tabs" Content="Ottimizzazioni" />
                            <RadioButton x:Name="TabLog" Style="{StaticResource Segment}" GroupName="tabs" Content="Registro" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScroll}" />
                        </ScrollViewer.Resources>
                        <Grid Margin="0,0,10,8">
                            <StackPanel x:Name="PanelTheme" />
                            <StackPanel x:Name="PanelComponents" Visibility="Collapsed" />
                            <StackPanel x:Name="PanelTweaks" Visibility="Collapsed" />
                            <StackPanel x:Name="PanelLog" Visibility="Collapsed" />
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Barra inferiore: avanzamento e azioni -->
                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="26,0,26,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Height="1" VerticalAlignment="Top" Grid.ColumnSpan="2" Background="{StaticResource Hairline}" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock x:Name="StatusText" Text="Pronto. Scegli cosa installare e premi INSTALLA." Foreground="{StaticResource Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                        <Grid Margin="0,10,0,0" Height="4">
                            <Border CornerRadius="2" Background="#14212A" />
                            <Border x:Name="ProgressFill" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0096C7" Offset="0" />
                                        <GradientStop Color="#38D6FF" Offset="0.8" />
                                        <GradientStop Color="#F2B544" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.RenderTransform><ScaleTransform x:Name="ProgressScale" ScaleX="0" /></Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkRemoveApps" Style="{StaticResource Toggle}" Margin="0,0,10,0" ToolTip="Al ripristino disinstalla anche le app installate da Stark HUD" />
                        <TextBlock Text="Rimuovi anche le app" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <Button x:Name="BtnRestore" Style="{StaticResource GhostButton}" Height="44" Content="Ripristina originale" Margin="0,0,12,0" />
                        <Button x:Name="BtnInstall" Style="{StaticResource PrimaryButton}" Height="44" MinWidth="160" Content="INSTALLA" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
