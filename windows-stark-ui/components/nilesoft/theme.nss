// Stark HUD - tema menu contestuale per Nilesoft Shell
// Installato in: C:\Program Files\Nilesoft Shell\imports\theme.nss (l'originale viene salvato nel backup)
theme
{
	name = "modern"
	dark = true
	background { color = #0A0F14 opacity = 94 effect = 3 }
	item
	{
		radius = 3
		text { normal = #EAF6FF select = #FFFFFF disabled = #5A6B78 }
		back { select = #0E3A4A }
	}
	border { enabled = true size = 1 color = #1E5A6E radius = 3 }
	shadow { enabled = true size = 8 opacity = 30 color = #000000 }
	separator.color = #1C3A47
	symbol { normal = #38D6FF select = #FFFFFF }
	font { name = "Segoe UI" size = 14 }
}
